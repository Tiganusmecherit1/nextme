{
  "name": "nextme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "wrangler pages dev dist",
    "db:local": "wrangler d1 migrations apply nextme-db --local",
    "db:remote": "wrangler d1 migrations apply nextme-db --remote",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:worker": "npm run build && node scripts/embed-assets.mjs && wrangler deploy -c wrangler.worker.toml"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "wrangler": "^4.40.0"
  }
}
